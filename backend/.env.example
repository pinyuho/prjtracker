# Server
PORT=4000
NODE_ENV="develop" # production / develop

# Auth (required)
# Generate SESSION_SECRET:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# Token encryption key (required)
# Must be base64 that decodes to exactly 32 bytes.
# Generate TOKEN_ENC_KEY:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# You may optionally prefix with "base64:".
TOKEN_ENC_KEY=base64:

# GitHub OAuth (required)
# Create a GitHub OAuth App and fill these values.
# Redirect URI must match GITHUB_REDIRECT_URI exactly.
GITHUB_SCOPE="read:user repo"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="http://localhost:4000/auth/github/callback" # Github 平台 Oauth app redirect uri 也要設定為 "http://localhost:4000"
FRONTEND_URL="http://localhost:3000"

# MongoDB (required)
# Example:
#   mongodb://localhost:27017/your_db
#   mongodb+srv://<user>:<pass>@cluster0.xxx.mongodb.net/your_db
MONGO_URL=
